{
  "name": "react-typescript",
  "version": "1.0.0",
  "description": "React and TypeScript example starter project",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "8.5.3",
    "firebase": "12.19.0",
    "loader-utils": "3.2.1",
    "lucide-react": "1.46.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "18.19.76",
    "@types/react": "18.2.38",
    "@types/react-dom": "18.2.15",
    "@webgpu/types": "0.1.74",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17",
    "typescript": "4.9.5"
  },
  "scripts": {
    "test:rules": "node --test scripts/firestore-rules.test.cjs",
    "test:releases": "node --test scripts/announce-update.test.cjs",
    "check:release-notes": "node scripts/announce-update.cjs --check",
    "fonts:update": "node scripts/vendor-fonts.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "sprites:cloud": "node scripts/build-cloud-atlas.cjs",
    "sprites:tweens": "python3 scripts/tween-cloud.py",
    "preview:egg": "node scripts/preview-egg.cjs",
    "preview:tour": "node scripts/preview-tour.cjs",
    "preview:podium": "node scripts/preview-podium.cjs",
    "podium:cloth": "node scripts/bake-podium-cloth.cjs",
    "audio:build": "node scripts/build-audio.cjs",
    "typecheck:egg": "tsc --project scripts/tsconfig.egg.json",
    "typecheck": "tsc --noEmit",
    "start": "react-scripts start",
    "start:emu": "node -e \"process.env.REACT_APP_EMULATORS='1';require('react-scripts/scripts/start')\"",
    "seed:emu": "node scripts/seed-emulators.cjs",
    "build": "node scripts/build.cjs",
    "cap:sync": "cap sync",
    "apk:sync": "npm run build && cap sync android",
    "apk:release": "npm run build && cap sync android && cd android && gradlew assembleRelease",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "android:bundle": "npm run build && cap sync android && cd android && gradlew bundleRelease"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
