{
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
        "strict": true,
        "types": ["react", "react-dom", "node"],
        "target": "es2018",
        "module": "esnext",
        "moduleResolution": "node",
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "lib": [
            "dom",
            "dom.iterable",
            "es2020"
        ],
        "jsx": "react-jsx"
    }
}
