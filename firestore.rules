rules_version = '2';

// Regole di Firestore per "Il Circuito". Si incollano in Firebase → Firestore Database → Regole → Pubblica.
// Tutto ciò che non è elencato qui sotto è NEGATO.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.get('releasePublisher', false) != true;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // pensieri: originali privati, tipo immutabile; i documenti senza kind sono scritti completi.
    // testi v2: diario integrale (anonimo, oppure firmato se l'autore lo sceglie) oppure solo estratto,
    // senza identità, date, voti o allegati dei completi.
    function pensiero(id) { return /databases/$(database)/documents/pensieri/$(id); }
    function tipo(d) { return d.get('kind', 'complete'); }
    function completo(id) { return exists(pensiero(id)) && tipo(get(pensiero(id)).data) == 'complete'; }
    function validoOriginale(d) {
      return d.keys().hasOnly(['title', 'content', 'strokes', 'w', 'h', 'author', 'timestamp', 'userId', 'isStarred', 'kind', 'excerpt', 'updatedAt', 'rating', 'svelato', 'firmato'])
        && d.keys().hasAll(['title', 'content', 'strokes', 'w', 'h', 'author', 'timestamp', 'userId', 'isStarred'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.content is string && d.content.size() <= 950000
        && d.strokes is list && d.strokes.size() <= 10000
        && d.w is number && d.w > 0 && d.w <= 200000
        && d.h is number && d.h > 0 && d.h <= 200000
        && d.author is string && d.author.size() <= 200
        && d.userId is string && d.timestamp is number && d.isStarred is bool
        && d.get('updatedAt', 0) is number
        && tipo(d) in ['complete', 'diary']
        && d.get('excerpt', '') is string && d.get('excerpt', '').size() <= 480
        && d.get('svelato', false) is bool
        && d.get('firmato', false) is bool
        // solo un pensiero del diario può portare il nome dell'autore
        && (tipo(d) == 'diary' || d.get('firmato', false) == false)
        && (!('rating' in d) || (d.rating is int && d.rating >= 1 && d.rating <= 5))
        && (tipo(d) == 'complete' || (!('rating' in d) && d.isStarred == false && d.get('svelato', false) == false && d.get('excerpt', '') == ''));
    }
    // copia pubblica del diario: nome e id dell'autore ci sono solo se l'originale è firmato, e sono quelli veri
    function firmaFedele(pub, original) {
      return (original.get('firmato', false) == true
          && pub.get('firma', null) == original.author && pub.get('autoreId', null) == original.userId)
        || (original.get('firmato', false) == false && !('firma' in pub) && !('autoreId' in pub));
    }
    function copiaFedele(id) {
      let d = request.resource.data;
      let original = getAfter(pensiero(id)).data;
      return d.get('version', 0) == 2 && d.kind == tipo(original) && d.title == original.title
        && ((d.kind == 'diary'
          && d.keys().hasOnly(['version', 'kind', 'title', 'content', 'strokes', 'w', 'h', 'firma', 'autoreId'])
          && d.keys().hasAll(['version', 'kind', 'title', 'content', 'strokes', 'w', 'h'])
          && d.content == original.content && d.strokes == original.strokes && d.w == original.w && d.h == original.h
          && firmaFedele(d, original))
        || (d.kind == 'complete'
          && d.keys().hasOnly(['version', 'kind', 'title', 'excerpt'])
          && d.keys().hasAll(['version', 'kind', 'title', 'excerpt'])
          && d.excerpt is string && d.excerpt.size() <= 480
          && d.excerpt.size() <= original.content.size() * 0.3
          && d.excerpt == original.get('excerpt', d.excerpt)));
    }
    function pubblicazioneAllineata(id) {
      let d = request.resource.data;
      let pub = getAfter(/databases/$(database)/documents/testi/$(id)).data;
      return pub.version == 2 && pub.kind == tipo(d) && pub.title == d.title
        && ((tipo(d) == 'diary' && pub.content == d.content && pub.strokes == d.strokes && pub.w == d.w && pub.h == d.h && firmaFedele(pub, d))
          || (tipo(d) == 'complete' && pub.excerpt == d.get('excerpt', '')));
    }
    match /pensieri/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validoOriginale(request.resource.data)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isStarred == false && !('rating' in request.resource.data)
        && request.resource.data.get('svelato', false) == false
        // Le vecchie app possono ancora salvare un completo privato, mai una copia integrale pubblica.
        && (!('kind' in request.resource.data) || pubblicazioneAllineata(id));
      allow update: if signedIn() && validoOriginale(request.resource.data)
        && tipo(request.resource.data) == tipo(resource.data)
        && (!('kind' in request.resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'content', 'strokes', 'w', 'h', 'excerpt', 'kind', 'firmato']) || pubblicazioneAllineata(id))
        && ((resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'strokes', 'w', 'h', 'excerpt', 'kind', 'updatedAt', 'firmato']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'strokes', 'w', 'h', 'excerpt', 'kind', 'updatedAt', 'rating', 'isStarred', 'svelato'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isStarred']) || request.resource.data.isStarred == false)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating'])
            || (tipo(resource.data) == 'complete' && resource.data.get('svelato', false) != true
              && (!('rating' in request.resource.data)
                || (request.resource.data.get('svelato', false) == true
                  && request.resource.data.rating == get(/databases/$(database)/documents/valutazioni/$(id)).data.get('voto', 0)))))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['svelato'])
            || (tipo(resource.data) == 'complete' && request.resource.data.svelato == true
              && resource.data.get('svelato', false) != true && request.resource.data.get('rating', 0) > 0))));
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /testi/{id} {
      // Vecchie copie integrali senza versione non sono più leggibili dagli utenti.
      // I nuovi client interrogano esclusivamente where(version == 2).
      allow read: if signedIn() && (isAdmin() || resource.data.version == 2);
      allow create, update: if signedIn() && existsAfter(pensiero(id))
        && (getAfter(pensiero(id)).data.userId == request.auth.uid || isAdmin()) && copiaFedele(id);
      allow delete: if isAdmin() || (signedIn() && exists(pensiero(id)) && get(pensiero(id)).data.userId == request.auth.uid);
    }

    // Annunci globali immutabili. L'identità della CI può pubblicare annunci, mai amministrare gli scritti.
    function releasePublisher() {
      return request.auth != null && request.auth.token.get('releasePublisher', false) == true
        && exists(/databases/$(database)/documents/release_publishers/$(request.auth.uid));
    }
    function validoAnnuncio(d, id) {
      return id.matches('^[a-f0-9]{40}$')
        && d.keys().hasOnly(['titolo', 'messaggio', 'versione', 'timestamp', 'commit'])
        && d.keys().hasAll(['titolo', 'messaggio', 'versione', 'timestamp', 'commit'])
        && d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= 140
        && d.messaggio is string && d.messaggio.size() > 0 && d.messaggio.size() <= 1600
        && d.versione is string && d.versione.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && d.commit == id && d.timestamp is number
        && d.timestamp > 0 && d.timestamp <= request.time.toMillis() + 60000;
    }
    match /aggiornamenti/{id} {
      allow read: if signedIn() || releasePublisher();
      allow create: if (isAdmin() || releasePublisher()) && validoAnnuncio(request.resource.data, id);
      allow update, delete: if false;
    }
    match /release_publishers/{uid} { allow read, write: if false; }
    match /letture_aggiornamenti/{uid}/annunci/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/aggiornamenti/$(id))
        && request.resource.data.keys().hasOnly(['letta', 'timestamp'])
        && request.resource.data.keys().hasAll(['letta', 'timestamp'])
        && request.resource.data.letta == true && request.resource.data.timestamp is number
        && request.resource.data.timestamp > 0 && request.resource.data.timestamp <= request.time.toMillis() + 60000;
      allow delete: if false;
    }

    // Notifica "hai ricevuto un voto": la crea l'admin allo svelamento, la legge e la segna come letta solo l'autore.
    match /notifiche/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if isAdmin()
        && completo(request.resource.data.pensieroId)
        && request.resource.data.userId == get(pensiero(request.resource.data.pensieroId)).data.userId
        && request.resource.data.keys().hasOnly(['userId', 'pensieroId', 'titolo', 'voto', 'timestamp', 'letta'])
        && request.resource.data.keys().hasAll(['userId', 'pensieroId', 'titolo', 'voto', 'timestamp', 'letta'])
        && request.resource.data.userId is string
        && request.resource.data.pensieroId is string
        && request.resource.data.titolo is string
        && request.resource.data.voto is int
        && request.resource.data.voto >= 1 && request.resource.data.voto <= 5
        && request.resource.data.timestamp is number
        && request.resource.data.letta == false;

      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta'])
        && request.resource.data.letta == true;

      allow delete: if false;
    }

    // Voto, segnalibro, stato e nota privata di ogni scritto: solo admin, l'autore non li vede mai.
    match /valutazioni/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && completo(id)
        && request.resource.data.keys().hasOnly(['stato', 'nota', 'voto', 'segnalibro', 'updatedAt'])
        && request.resource.data.get('stato', 'da_leggere') in ['da_leggere', 'letto', 'shortlist', 'scelto']
        && request.resource.data.get('nota', '') is string && request.resource.data.get('nota', '').size() <= 2000
        && request.resource.data.get('voto', 0) is int
        && request.resource.data.get('voto', 0) >= 0 && request.resource.data.get('voto', 0) <= 5
        && request.resource.data.get('segnalibro', false) is bool
        && request.resource.data.updatedAt is number;
    }

    match /profili/{uid} {
      allow read: if signedIn();

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'status', 'bio', 'avatar', 'banner', 'bannerImg', 'bannerY', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 40
        && request.resource.data.status is string && request.resource.data.status.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 320
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 200000
        && (request.resource.data.avatar == '' || request.resource.data.avatar.matches('data:image/.*'))
        && request.resource.data.banner in ['teal', 'amber', 'indigo', 'rose', 'sky', 'slate']
        // Copertina personale (facoltativa): immagine come data URL e posizione verticale in percentuale.
        && (!('bannerImg' in request.resource.data)
            || (request.resource.data.bannerImg is string
                && request.resource.data.bannerImg.size() <= 400000
                && request.resource.data.bannerImg.matches('data:image/.*')))
        && (!('bannerY' in request.resource.data)
            || (request.resource.data.bannerY is number
                && request.resource.data.bannerY >= 0 && request.resource.data.bannerY <= 100))
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow delete: if false;
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Ognuno può leggere solo il proprio documento: serve all'app per sapere se sei admin davvero.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
